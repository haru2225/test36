#!/usr/bin/env bash
# Submit from the directory containing test36.py; see TEST36.md.
#PBS -q sg8
#PBS -N test36_clay_cg
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=8:mem=32gb:ngpus=1
#PBS -j oe
set -euo pipefail
WORK_DIR="${PBS_O_WORKDIR:?Submit with qsub from the test36 directory}"
cd "$WORK_DIR"
WORK_DIR="$(pwd -P)"
STAGE="${STAGE:-train}"
DM2_ROOT="${DM2_ROOT:-$WORK_DIR/DM2}"
SIF_IMAGE="${SIF_IMAGE:-$WORK_DIR/test36.sif}"
OUTPUT_DIR="${OUTPUT_DIR:?Set OUTPUT_DIR to a new directory, or the training directory with RESUME=1}"
RUNTIME="${CONTAINER_RUNTIME:-singularity}"
[[ -d "$DM2_ROOT/src/graphite" ]] || { echo "Missing DM2/src/graphite: $DM2_ROOT" >&2; exit 2; }
[[ -r "$SIF_IMAGE" ]] || { echo "Missing container: $SIF_IMAGE" >&2; exit 2; }
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR="$(cd "$OUTPUT_DIR" && pwd -P)"
DM2_ROOT="$(cd "$DM2_ROOT" && pwd -P)"
cmd=("$RUNTIME" exec --nv --bind "$WORK_DIR:/work:ro" --bind "$DM2_ROOT:/dm2:ro"
     --bind "$OUTPUT_DIR:/output" --env DM2_ROOT=/dm2 --env OMP_NUM_THREADS=8 --pwd /work)
args=("$STAGE" --output /output)
case "$STAGE" in
    train)
        DATASET_PATH="${DATASET_PATH:?Set DATASET_PATH to the prepared test36 dataset}"
        DATASET_PATH="$(cd "$DATASET_PATH" && pwd -P)"
        cmd+=(--bind "$DATASET_PATH:/dataset:ro")
        args+=(--dataset /dataset --device cuda --updates "${UPDATES:-30000}"
               --batch-size "${BATCH_SIZE:-16}" --time-budget-hours "${TIME_BUDGET_HOURS:-11.5}")
        [[ "${RESUME:-0}" == 1 ]] && args+=(--resume)
        ;;
    generate|export|md)
        CHECKPOINT_PATH="${CHECKPOINT_PATH:?Set CHECKPOINT_PATH to the test36 checkpoint.pt}"
        [[ -r "$CHECKPOINT_PATH" ]] || { echo "Missing checkpoint" >&2; exit 2; }
        cmd+=(--bind "$CHECKPOINT_PATH:/checkpoint.pt:ro")
        args+=(--checkpoint /checkpoint.pt)
        if [[ "$STAGE" == generate ]]; then
            args+=(--device cuda --time-budget-hours "${TIME_BUDGET_HOURS:-11.5}")
            [[ "${RESUME:-0}" == 1 ]] && args+=(--resume)
        else
            args+=(--sigma-ref "${SIGMA_REF:?Choose experimental SIGMA_REF in angstrom}")
            if [[ "$STAGE" == md ]]; then
                args+=(--device cuda --steps "${STEPS:-1000}" --time-budget-hours "${TIME_BUDGET_HOURS:-11.5}")
            fi
        fi
        ;;
    *) echo "Supported PBS stages: train, generate, export, md" >&2; exit 2 ;;
esac
"${cmd[@]}" "$SIF_IMAGE" python -u /work/test36.py "${args[@]}"
